[Unit]
Description=Agent Swarm Studio Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/agent-swarm/backend
EnvironmentFile=/var/www/agent-swarm/.env
ExecStart=/var/www/agent-swarm/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
